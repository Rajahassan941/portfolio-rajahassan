# Public URL of the deployed site — used for canonical URLs, Open Graph, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). Without these, the form
# validates and then opens the visitor's email app with the message prefilled.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
